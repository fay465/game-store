<section>
  <div class="mx-auto max-w-screen-xl px-4 py-8 sm:px-6 lg:px-8">
	<header class="mb-8 flex items-end justify-between">
	  <div class="text-left">
	    <h1 class="text-2xl sm:text-3xl font-bold font-retro text-acc">Catálogo</h1>
	    <p class="mt-2 text-sm text-muted font-8bit">Explora y agrega a tu carro</p>
	  </div>

	  <a href={~p"/cart"}
	     class="inline-flex items-center gap-2 rounded-sm px-4 py-2 text-sm font-8bit
	            bg-[var(--acc)] text-slate-900 hover:brightness-110 transition">
	    <!-- ícono carrito -->
	    <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
	      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.083.835l.383 1.531M7.5 14.25h9.75a1.5 1.5 0 001.463-1.153l1.286-5.785A1.125 1.125 0 0018.9 6H5.25M7.5 14.25L5.25 6M7.5 14.25l-.75 3M17.25 14.25l.75 3M6.75 17.25h12" />
	    </svg>
	    Ver Carro
	  </a>
	</header>

    <%= if @products == [] do %>
      <p class="text-muted">No hay productos aún.</p>
    <% else %>
      <ul
        class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
        role="list"
      >
        <%= for p <- @products do %>
          <li>
            <article class="group relative block overflow-hidden rounded-sm border border-slate-700 bg-panel">
              <!-- Imagen con proporción 256x362 sin recorte -->
              <div class="w-full" style="aspect-ratio:256/362;">
                <img
                  src={GameStoreWeb.ProductHelpers.product_image(p)}
                  alt={"Portada " <> p.title}
                  class="w-full h-full object-contain transition duration-500 group-hover:scale-[1.02]"
                />
              </div>
		<div class="relative border-t border-slate-700 p-4">
		  <h3 class="text-base font-8bit text-[var(--text)] truncate"><%= p.title %></h3>

		  <p class="mt-1 text-sm text-muted font-8bit">
		    <%= GameStoreWeb.MoneyHelpers.clp(p.price_cents) %>
		  </p>

		  <!-- Stock -->
		  <p class={"mt-1 text-xs font-8bit " <> if p.stock == 0, do: "text-rose-400", else: "text-muted"}>
		    Stock: <%= p.stock %>
		  </p>

		  <div class="mt-4">
		    <button
		      phx-click="add"
		      phx-value-id={p.id}
		      disabled={p.stock == 0}
		      class={"block w-full rounded-sm px-4 py-2 text-sm font-8bit transition " <>
		             if(p.stock == 0,
		               do: "bg-slate-600 text-slate-300 cursor-not-allowed",
		               else: "bg-[var(--acc)] text-slate-900 hover:brightness-110")}
		    >
		      <%= if p.stock == 0, do: "Agotado", else: "Agregar al carro" %>
		    </button>
		  </div>
		</div>
            </article>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</section>

