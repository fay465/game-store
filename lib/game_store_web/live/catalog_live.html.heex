<h1 class="text-2xl font-bold">Tienda de Videojuegos</h1>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
  <%= for p <- @products do %>
    <div class="border rounded p-4">
      <h2 class="font-semibold"><%= p.title %></h2>
      <p class="text-sm">SKU: <%= p.sku %></p>
      <p class="mt-2">Precio: <%= GameStoreWeb.MoneyHelpers.clp(p.price_cents) %></p>
      <button phx-click="add" phx-value-id={p.id} class="mt-3 px-3 py-1 bg-blue-600 text-white rounded">
        Agregar
      </button>
    </div>
  <% end %>
</div>
<a href="/cart" class="inline-block mt-6 underline">Ver carro</a>
