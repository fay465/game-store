<section>
  <div class="mx-auto max-w-screen-xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <header class="text-center">
        <h1 class="text-2xl sm:text-3xl font-bold font-retro text-acc">Tu Carro</h1>
        <p class="mt-2 text-sm text-muted font-8bit">Videojuegos digitales</p>
      </header>

      <%= if @cart.status == "closed" do %>
        <div class="mt-6 mb-4 rounded-sm bg-green-50/10 border border-green-400/40 px-4 py-2 text-green-300">
          Carro cerrado
        </div>
      <% end %>

      <div class="mt-8">
        <%= if @cart && not Enum.empty?(@totals.items) do %>
          <ul class="space-y-4">
            <%= for it <- @totals.items do %>
              <li class="flex items-center gap-4">
                <!-- Portada 256×362 sin recorte -->
                <div class="rounded-sm bg-panel overflow-hidden w-16 md:w-20" style="aspect-ratio: 256/362;">
                  <img
                    src={GameStoreWeb.ProductHelpers.product_image(it.product)}
                    alt={it.product.title}
                    class="w-full h-full object-contain"
                  />
                </div>

                <div class="min-w-0">
                  <h3 class="text-sm font-8bit text-[var(--text)] truncate"><%= it.product.title %></h3>
                  <p class="mt-0.5 text-[12px] text-muted font-8bit">
                    Unidad: <%= GameStoreWeb.MoneyHelpers.clp(it.product.price_cents) %>
                  </p>
                </div>

                <div class="flex flex-1 items-center justify-end gap-3">
                  <!-- Controles cantidad -->
                  <div class="flex items-center gap-2">
                    <button phx-click="dec" phx-value-id={it.id}
                      disabled={@cart.status == "closed"}
                      class={"h-8 w-8 grid place-items-center rounded-sm border border-slate-600 text-slate-100 hover:bg-slate-700 " <>
                             if(@cart.status == "closed", do: "opacity-50 cursor-not-allowed", else: "")}>
                      −
                    </button>

                    <span class="inline-block w-12 text-center text-xs font-8bit text-[var(--text)]">
                      <%= it.quantity %>
                    </span>

                    <button phx-click="inc" phx-value-id={it.id}
                      disabled={@cart.status == "closed"}
                      class={"h-8 w-8 grid place-items-center rounded-sm border border-slate-600 text-slate-100 hover:bg-slate-700 " <>
                             if(@cart.status == "closed", do: "opacity-50 cursor-not-allowed", else: "")}>
                      +
                    </button>
                  </div>

                  <!-- Eliminar -->
                  <button phx-click="del" phx-value-id={it.id}
                    disabled={@cart.status == "closed"}
                    class={"transition btn-danger hover:opacity-80 " <>
                           if(@cart.status == "closed", do: "opacity-50 cursor-not-allowed", else: "")}
                    aria-label="Eliminar">
                    <!-- Ícono simple (X) para evitar SVGs largos -->
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                  </button>
                </div>
              </li>
            <% end %>
          </ul>

          <!-- Totales -->
          <div class="mt-8 flex justify-end border-t border-slate-700 pt-8">
            <div class="w-screen max-w-lg space-y-4">
              <dl class="space-y-0.5 text-sm text-slate-300">
                <div class="flex justify-between">
                  <dt>Subtotal</dt>
                  <dd><%= GameStoreWeb.MoneyHelpers.clp(@totals.subtotal_cents) %></dd>
                </div>

                <div class="flex justify-between !text-base font-medium">
                  <dt>Total</dt>
                  <dd><%= GameStoreWeb.MoneyHelpers.clp(@totals.subtotal_cents) %></dd>
                </div>
              </dl>
		<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
		  <a href={~p"/"}
		     class="inline-flex items-center gap-2 rounded-sm px-4 py-2 text-sm font-8bit
		            border border-slate-700 text-[var(--text)] hover:bg-slate-800 transition">
		    <!-- ícono flecha ← -->
		    <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
		      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
		    </svg>
		    Seguir comprando
		  </a>

		  <button phx-click="checkout"
		    disabled={@cart.status == "closed"}
		    class={"block rounded-sm px-5 py-3 text-sm font-8bit transition " <>
		           if(@cart.status == "closed",
		             do: "bg-slate-600 text-slate-300 cursor-not-allowed",
		             else: "bg-[var(--acc)] text-slate-900 hover:brightness-110")}>
		    Finalizar compra
		  </button>
		</div>
            </div>
          </div>
        <% else %>
          <p class="text-muted">Tu carro está vacío.</p>
        <% end %>
      </div> <!-- .mt-8 -->
    </div>   <!-- .max-w-3xl -->
  </div>     <!-- .max-w-screen-xl -->
</section>
